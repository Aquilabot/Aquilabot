[174.636138, "o", "PASS start-turn-expiry: An unused Dead Aim expired at the start of the hunter's next turn (expected \"ready=false, mark=false, tracking=false\", actual \"ready=false, mark=false, tracking=false\")\r\nPASS expired-hit-resistant: The attack remained resisted after the unused mark expired (expected \"4\", actual \"4\")\r\n"]
